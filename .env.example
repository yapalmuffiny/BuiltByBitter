# ─────────────────────────────────────────────────────────────
# BuiltByBitter environment — copy to `.env` and fill in.
# `.env` is gitignored. NEVER commit real secrets.
# These are read ONLY by the Electron main process.
# ─────────────────────────────────────────────────────────────

# Local embedded auth/api server (loopback only)
AUTH_PORT=8788

# The app uses an embedded SQLite database stored in the OS app-data dir
# (…/Application Support/BuiltByBitter/builtbybitter.db) — no external database
# to configure. drizzle-kit (db:generate/db:push/db:studio) uses ./local.db.

# BetterAuth signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# BuiltByBit OAuth application (login only — does NOT grant creator-API access)
# OPTIONAL for local dev. In the shipped app each user enters their own Client ID
# and Secret in-app (Login screen / Settings), stored encrypted in the Keychain;
# those take precedence over anything set here. Register this EXACT redirect URI
# in your BBB app:
#   http://localhost:8788/api/auth/callback/builtbybit
BBB_OAUTH_CLIENT_ID=client-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BBB_OAUTH_CLIENT_SECRET=secret-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only `members.self` is OAuth2-allowed on BBB (used for login identity).
BBB_OAUTH_SCOPES=members.self

# Discord OAuth (fallback login). Redirect URI:
#   http://127.0.0.1:8788/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
